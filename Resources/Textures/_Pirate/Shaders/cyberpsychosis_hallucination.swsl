uniform sampler2D SCREEN_TEXTURE;

uniform highp float hallucinationPower;
uniform highp float time;
uniform highp float sanityNormalized;

highp vec2 hash(highp vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return fract(sin(p) * 43758.5453);
}

void fragment() {
    highp vec2 uv = Pos;
    highp vec4 color = texture(SCREEN_TEXTURE, Pos);

    if (hallucinationPower <= 0.0) {
        COLOR = color;
        return;
    }

    // Chromatic aberration
    highp float aberration = hallucinationPower * 0.015;
    highp float r = texture(SCREEN_TEXTURE, uv + vec2(aberration * sin(time * 12.0), 0.0)).r;
    highp float g = texture(SCREEN_TEXTURE, uv).g;
    highp float b = texture(SCREEN_TEXTURE, uv - vec2(aberration * cos(time * 12.0), 0.0)).b;

    // Noise overlay
    highp vec2 noiseUv = uv * 50.0 + time * 3.0;
    highp float noise = hash(noiseUv).x * hallucinationPower * 0.08;

    // Geometric distortion waves
    highp vec2 distort = vec2(
        sin(uv.y * 10.0 + time * 2.0) * 0.008,
        cos(uv.x * 8.0 + time * 1.5) * 0.006
    ) * hallucinationPower;

    highp vec2 distortUv = uv + distort;

    highp vec3 distortedColor = vec3(
        texture(SCREEN_TEXTURE, distortUv + vec2(aberration * sin(time * 12.0), 0.0)).r,
        texture(SCREEN_TEXTURE, distortUv).g,
        texture(SCREEN_TEXTURE, distortUv - vec2(aberration * cos(time * 12.0), 0.0)).b
    );

    highp vec3 finalColor = mix(color.rgb, distortedColor, hallucinationPower * 0.6);
    finalColor += vec3(noise);

    // Vignette that increases with hallucination
    highp float vignette = 1.0 - length(Pos - 0.5) * 1.2;
    vignette = pow(vignette, 2.0);
    vignette = mix(1.0, vignette, hallucinationPower * 0.4);

    COLOR = vec4(finalColor * vignette, 1.0);
}