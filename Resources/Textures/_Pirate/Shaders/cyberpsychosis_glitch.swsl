uniform sampler2D SCREEN_TEXTURE;

uniform highp float glitchPower;
uniform highp float time;
uniform highp float sanityNormalized;

highp float rand(highp vec2 co) {
    return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
    highp vec2 uv = Pos;
    highp vec4 color = texture(SCREEN_TEXTURE, Pos);

    if (glitchPower <= 0.0) {
        COLOR = color;
        return;
    }

    // Scanlines - denser and more aggressive
    highp float scanline = sin(uv.y * 1000.0 + time * 80.0) * 0.04 * glitchPower;
    highp vec2 scanUv = uv + vec2(0.0, scanline);

    // Multiple horizontal tearing / pixel sorting layers
    highp float tearOffset = 0.0;
    highp float tearOffset2 = 0.0;
    if (rand(vec2(floor(uv.y * 50.0), time * 15.0)) < 0.035 * glitchPower) {
        tearOffset = (rand(vec2(floor(uv.y * 50.0), time * 15.0 + 100.0)) - 0.5) * 0.15 * glitchPower;
        tearOffset2 = (rand(vec2(floor(uv.y * 50.0), time * 15.0 + 200.0)) - 0.5) * 0.08 * glitchPower;
    }

    // RGB channel separation during glitches - stronger
    highp float r = texture(SCREEN_TEXTURE, uv + vec2(tearOffset + 0.006 * glitchPower, 0.0)).r;
    highp float g = texture(SCREEN_TEXTURE, uv + vec2(0.0, scanline)).g;
    highp float b = texture(SCREEN_TEXTURE, uv - vec2(tearOffset2 + 0.006 * glitchPower, 0.0)).b;

    // Pixel sorting blocks - more frequent and larger
    highp float blockGlitch = 0.0;
    if (rand(vec2(floor(uv.x * 25.0), floor(uv.y * 25.0) + time * 3.0)) < 0.018 * glitchPower) {
        blockGlitch = 1.0;
    }

    // Second pixel sorting layer
    highp float blockGlitch2 = 0.0;
    if (rand(vec2(floor(uv.x * 15.0), floor(uv.y * 15.0) + time * 5.0 + 500.0)) < 0.012 * glitchPower) {
        blockGlitch2 = 1.0;
    }

    highp vec3 glitchColor = vec3(r, g, b);
    if (blockGlitch > 0.5) {
        // Pixel sort effect - shift horizontally
        highp float sortShift = sin(time * 40.0 + uv.y * 60.0) * 0.08 * glitchPower;
        glitchColor = texture(SCREEN_TEXTURE, uv + vec2(sortShift, 0.0)).rgb;
    }
    if (blockGlitch2 > 0.5) {
        // Vertical pixel sort
        highp float sortShift2 = cos(time * 30.0 + uv.x * 40.0) * 0.05 * glitchPower;
        glitchColor = texture(SCREEN_TEXTURE, uv + vec2(0.0, sortShift2)).rgb;
    }

    // Scanline darkening - stronger
    highp float scanDark = 1.0 - sin(uv.y * 800.0) * 0.18 * glitchPower;

    // Static noise - more intense
    highp float staticNoise = (rand(uv * 150.0 + time * 30.0) - 0.5) * 0.18 * glitchPower;

    // Color channel swap glitches
    highp float channelSwap = rand(vec2(floor(time * 2.0), 0.0));
    if (channelSwap < 0.02 * glitchPower) {
        glitchColor = glitchColor.brg; // Rotate RGB
    }

    highp vec3 finalColor = mix(color.rgb, glitchColor, glitchPower * 0.85);
    finalColor *= scanDark;
    finalColor += vec3(staticNoise);

    // Random bright flashes
    if (rand(vec2(floor(time * 5.0), 0.0)) < 0.01 * glitchPower) {
        finalColor += vec3(0.3, 0.3, 0.3);
    }

    COLOR = vec4(finalColor, 1.0);
}