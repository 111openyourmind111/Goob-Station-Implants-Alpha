// SPDX-License-Identifier: AGPL-3.0-or-later

uniform sampler2D SCREEN_TEXTURE;

uniform highp float realityBreakPower;
uniform highp float time;

highp vec2 rotate(highp vec2 v, highp float a) {
    highp float s = sin(a), c = cos(a);
    return mat2(c, -s, s, c) * v;
}

void fragment() {
    highp vec2 uv = Pos;
    highp vec4 screenColor = texture(SCREEN_TEXTURE, Pos);

    if (realityBreakPower <= 0.0) {
        COLOR = screenColor;
        return;
    }

    // Center for radial effects
    highp vec2 center = vec2(0.5, 0.5);
    highp vec2 diff = uv - center;
    highp float dist = length(diff);

    // Geometry warping - spiral distortion - STRONGER
    highp float spiral = realityBreakPower * 0.9;
    highp float spiralFactor = 1.0 + spiral * sin(dist * 25.0 - time * 4.0) * 0.18;
    uv = center + diff * spiralFactor;

    // Secondary wave distortion
    highp float wave = sin(dist * 15.0 - time * 5.0) * 0.06 * realityBreakPower;
    uv += diff * wave;

    // Rotation that increases with time - faster
    highp float rotation = realityBreakPower * sin(time * 0.8) * 0.5;
    uv = center + rotate(uv - center, rotation);

    // Color inversion pulses - more aggressive
    highp float invertPulse = sin(time * 3.0) * 0.5 + 0.5;
    highp float invertAmount = realityBreakPower * invertPulse * 0.7;

    // Sample with distorted UV
    highp vec4 distortedColor = texture(SCREEN_TEXTURE, uv);

    // Color inversion
    highp vec3 inverted = 1.0 - distortedColor.rgb;
    highp vec3 mixedColor = mix(distortedColor.rgb, inverted, invertAmount);

    // Psychedelic color cycling
    highp float colorCycle = sin(time * 0.7 + dist * 10.0) * 0.5 + 0.5;
    mixedColor = mix(mixedColor, vec3(colorCycle, colorCycle * 0.7, colorCycle * 1.3) * 0.5, realityBreakPower * 0.3);

    // Vignette that closes in - much tighter
    highp float vignette = 1.0 - length(Pos - 0.5) * 2.8;
    vignette = pow(vignette, 4.0);
    vignette = mix(1.0, vignette, realityBreakPower * 0.8);

    // Chromatic aberration - stronger
    highp float aberration = realityBreakPower * 0.035;
    highp float r = texture(SCREEN_TEXTURE, uv + vec2(aberration, 0.0)).r;
    highp float g = distortedColor.g;
    highp float b = texture(SCREEN_TEXTURE, uv - vec2(aberration, 0.0)).b;

    highp vec3 finalColor = mix(mixedColor, vec3(r, g, b), realityBreakPower * 0.5);

    // Scanline interference - denser
    highp float interference = sin(Pos.y * 1000.0 + time * 50.0) * 0.05 * realityBreakPower;
    finalColor += vec3(interference);

    // Digital noise - stronger
    highp float noise = fract(sin(dot(Pos * 150.0, vec2(12.9898, 78.233)) + time * 15.0) * 43758.5453);
    finalColor += (noise - 0.5) * 0.18 * realityBreakPower;

    // Horizontal tear lines
    highp float tear = sin(Pos.y * 30.0 + time * 20.0) * 0.04 * realityBreakPower;
    finalColor += vec3(tear);

    // Random color channel drops
    if (fract(sin(time * 7.0) * 43758.5453) < 0.02 * realityBreakPower) {
        finalColor = finalColor.gbr;
    }
    if (fract(sin(time * 11.0) * 43758.5453) < 0.015 * realityBreakPower) {
        finalColor = finalColor.brg;
    }

    // Random bright flashes / screen flash
    if (fract(sin(time * 13.0) * 43758.5453) < 0.008 * realityBreakPower) {
        finalColor += vec3(0.4, 0.3, 0.5);
    }

    // Screen shake simulation via UV jitter
    highp float shake = (fract(sin(time * 60.0) * 43758.5453) - 0.5) * 0.02 * realityBreakPower;
    uv.x += shake;

    COLOR = vec4(finalColor * vignette, 1.0);
}