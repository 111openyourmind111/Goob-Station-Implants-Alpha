// SPDX-License-Identifier: AGPL-3.0-or-later

uniform sampler2D SCREEN_TEXTURE;

uniform highp float realityBreakPower;
uniform highp float time;

highp vec2 rotate(highp vec2 v, highp float a) {
    highp float s = sin(a), c = cos(a);
    return mat2(c, -s, s, c) * v;
}

highp float rand(highp vec2 co) {
    return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
    highp vec2 uv = Pos;
    highp vec4 screenColor = texture(SCREEN_TEXTURE, Pos);

    if (realityBreakPower <= 0.0) {
        COLOR = screenColor;
        return;
    }

    // Center for radial effects
    highp vec2 center = vec2(0.5, 0.5);
    highp vec2 diff = uv - center;
    highp float dist = length(diff);

    // EXTREME Geometry warping - spiral + wave distortion
    highp float spiral = realityBreakPower * 1.5;
    highp float spiralFactor = 1.0 + spiral * sin(dist * 30.0 - time * 5.0) * 0.25;
    uv = center + diff * spiralFactor;

    // Secondary wave distortion
    highp float wave = sin(dist * 20.0 - time * 7.0) * 0.1 * realityBreakPower;
    uv += diff * wave;

    // Tertiary micro-distortion
    highp float micro = sin(dist * 50.0 - time * 15.0) * 0.03 * realityBreakPower;
    uv += diff * micro;

    // Rotation - faster and more erratic
    highp float rotation = realityBreakPower * sin(time * 1.2) * 0.8;
    uv = center + rotate(uv - center, rotation);

    // Color inversion pulses - aggressive
    highp float invertPulse = sin(time * 4.0) * 0.5 + 0.5;
    highp float invertAmount = realityBreakPower * invertPulse * 0.9;

    // Sample with distorted UV
    highp vec4 distortedColor = texture(SCREEN_TEXTURE, uv);

    // Color inversion
    highp vec3 inverted = 1.0 - distortedColor.rgb;
    highp vec3 mixedColor = mix(distortedColor.rgb, inverted, invertAmount);

    // Psychedelic color cycling - intense
    highp float colorCycle = sin(time * 1.0 + dist * 15.0) * 0.5 + 0.5;
    mixedColor = mix(mixedColor, vec3(colorCycle, colorCycle * 0.5, colorCycle * 1.5) * 0.7, realityBreakPower * 0.5);

    // RGB shift pulses
    highp float rgbShift = sin(time * 3.0) * 0.5 + 0.5;
    mixedColor = mix(mixedColor, mixedColor.brg, realityBreakPower * rgbShift * 0.2);
    mixedColor = mix(mixedColor, mixedColor.gbr, realityBreakPower * rgbShift * 0.15);

    // Vignette that closes in violently
    highp float vignette = 1.0 - length(Pos - 0.5) * 3.5;
    vignette = pow(vignette, 5.0);
    vignette = mix(1.0, vignette, realityBreakPower * 0.9);
    vignette *= 1.0 - sin(time * 2.0) * 0.2 * realityBreakPower;

    // Chromatic aberration - massive
    highp float aberration = realityBreakPower * 0.05;
    highp float r = texture(SCREEN_TEXTURE, uv + vec2(aberration, 0.0)).r;
    highp float g = distortedColor.g;
    highp float b = texture(SCREEN_TEXTURE, uv - vec2(aberration, 0.0)).b;

    highp vec3 finalColor = mix(mixedColor, vec3(r, g, b), realityBreakPower * 0.6);

    // Scanline interference - very dense
    highp float interference = sin(Pos.y * 1500.0 + time * 100.0) * 0.08 * realityBreakPower;
    finalColor += vec3(interference);

    // Digital noise - strong
    highp float noise = fract(sin(dot(Pos * 200.0, vec2(12.9898, 78.233)) + time * 25.0) * 43758.5453);
    finalColor += (noise - 0.5) * 0.25 * realityBreakPower;

    // Horizontal tear lines
    highp float tear = sin(Pos.y * 35.0 + time * 60.0) * 0.08 * realityBreakPower;
    finalColor += vec3(tear);

    // Random color channel drops - frequent
    if (fract(sin(time * 9.0) * 43758.5453) < 0.03 * realityBreakPower) {
        finalColor = finalColor.gbr;
    }
    if (fract(sin(time * 13.0) * 43758.5453) < 0.02 * realityBreakPower) {
        finalColor = finalColor.brg;
    }
    if (fract(sin(time * 17.0) * 43758.5453) < 0.015 * realityBreakPower) {
        finalColor = finalColor.bgr;
    }

    // Random bright flashes - white
    if (fract(sin(time * 11.0) * 43758.5453) < 0.012 * realityBreakPower) {
        finalColor += vec3(0.5, 0.4, 0.6);
    }
    // Magenta flash
    if (fract(sin(time * 19.0) * 43758.5453) < 0.008 * realityBreakPower) {
        finalColor += vec3(0.8, 0.0, 1.0);
    }
    // Cyan flash
    if (fract(sin(time * 23.0) * 43758.5453) < 0.006 * realityBreakPower) {
        finalColor += vec3(0.0, 1.0, 1.0);
    }
    // Full white flash
    if (fract(sin(time * 29.0) * 43758.5453) < 0.004 * realityBreakPower) {
        finalColor = vec3(1.0, 1.0, 1.0);
    }
    // Inversion flash
    if (fract(sin(time * 31.0) * 43758.5453) < 0.003 * realityBreakPower) {
        finalColor = 1.0 - finalColor;
    }

    // Screen shake simulation via UV jitter
    highp float shake = (rand(vec2(floor(time * 120.0), 0.0)) - 0.5) * 0.04 * realityBreakPower;
    uv.x += shake;

    // Micro jitter
    highp float microShake = (rand(vec2(floor(time * 200.0), 0.0)) - 0.5) * 0.015 * realityBreakPower;
    uv.y += microShake;

    COLOR = vec4(finalColor * vignette, 1.0);
}